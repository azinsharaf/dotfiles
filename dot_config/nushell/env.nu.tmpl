# env.nu
# Nushell environment variables - loaded once at startup.
# Cross-platform via chezmoi templating.

# Default applications
$env.EDITOR = "nvim"
$env.VISUAL = "nvim"

# Home (chezmoi resolves across darwin/linux/windows)
$env.HOME = {{ .chezmoi.homeDir | quote }}

# XDG dirs (Unix conventions; harmless on Windows)
$env.XDG_CONFIG_HOME = ($env.HOME | path join ".config")
$env.XDG_CACHE_HOME  = ($env.HOME | path join ".cache")
$env.XDG_DATA_HOME   = ($env.HOME | path join ".local" "share")
$env.XDG_STATE_HOME  = ($env.HOME | path join ".local" "state")

# Yazi (defaults to $XDG_CONFIG_HOME/yazi; set explicitly for clarity)
$env.YAZI_CONFIG_HOME = ($env.XDG_CONFIG_HOME | path join "yazi")

# Zellij
$env.ZELLIJ_CONFIG_DIR = ($env.XDG_CONFIG_HOME | path join "zellij")

# Starship prompt binary
$env.STARSHIP_SHELL = "nu"

# Carapace
$env.CARAPACE_BRIDGES = 'zsh,fish,bash,inshellisense' # optional

# Terminal
$env.COLORTERM = 'truecolor'

# Temp dirs
$env.TMP = ($env.HOME | path join ".tmp")
$env.TMPDIR = ($env.HOME | path join ".tmp")

# App config dirs
$env.MPV_HOME = ($env.HOME | path join ".config" "mpv")
$env.YOUTUBETUI_CONFIG_HOME = ($env.HOME | path join ".config" "youtube-tui")
$env.STARSHIP_CONFIG = ($env.HOME | path join ".config" "starship" "starship.toml")
$env.BAT_CONFIG_DIR = ($env.HOME | path join ".config" "bat")
$env.BAT_CONFIG_PATH = ($env.HOME | path join ".config" "bat" "bat.conf")
$env.EZA_CONFIG_DIR = ($env.HOME | path join ".config" "eza")
$env.GNUPGHOME = ($env.HOME | path join ".config" "gnupg")

# Windows / scoop paths
$env.KOMOREBI_CONFIG_HOME = ($env.HOME | path join ".config" "komorebi")
$env.KOMOREBI_AHK_EXE = ($env.HOME | path join "scoop" "apps" "autohotkey" "current" "UX" "AutoHotkeyUX.exe")
$env.YAZI_FILE_ONE = ($env.HOME | path join "scoop" "apps" "git" "current" "usr" "bin" "file.exe")
$env.NEOVIM_NODE_PATH = ($env.HOME | path join "scoop" "apps" "nodejs-nightly" "current" "node.exe")

# Yazi zoxide options
$env.YAZI_ZOXIDE_OPTS = "--preview 'eza --color=always --icons --group-directories-first --tree --level=2 {2}' --preview-window=right,40%,border-left"

# CUDA
$env.CUDA_PATH = 'C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8'
$env.CUDA_PATH_V12_8 = 'C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8'

# Language / toolchains
$env.CARGO_HOME = ($env.HOME | path join ".cargo")
$env.RUSTUP_HOME = ($env.HOME | path join ".rustup")
$env.UV_TOOL_DIR = ($env.HOME | path join ".venvs")
