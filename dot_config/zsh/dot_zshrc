# ~/.config/zsh/.zshrc
# Minimal, vim-based zsh configuration.

# ── Environment ──
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"

# XDG
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# ── History ──
HISTFILE="$ZDOTDIR/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt append_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt share_history

# ── Vi mode ──
bindkey -v
export KEYTIMEOUT=1

# Partial emacs bindings in insert mode
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char
bindkey '^W' backward-kill-word
bindkey '^U' backward-kill-line
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# Vim-style searching
bindkey '^R' history-incremental-search-backward

# ── Completion ──
autoload -Uz compinit
[[ -d "$XDG_CACHE_HOME/zsh" ]] || mkdir -p "$XDG_CACHE_HOME/zsh"
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ── Aliases ──
alias ls='eza --group-directories-first 2>/dev/null || ls --color=auto'
alias l='eza -lah --group-directories-first --icons 2>/dev/null || ls -lah'
alias ll='eza -lh --group-directories-first 2>/dev/null || ls -lh'
alias la='eza -lha --group-directories-first 2>/dev/null || ls -lha'
alias lt='eza --tree 2>/dev/null || tree'
alias lr='eza -lahR --group-directories-first 2>/dev/null || ls -lahR'
alias ld='eza -lhD --group-directories-first 2>/dev/null || ls -ld'
alias ldot='eza -ld .* --group-directories-first 2>/dev/null || ls -ld .*'
alias cat='bat --paging=never 2>/dev/null || cat'
alias n='nvim'
alias lg='lazygit'
alias y='yazi'
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'
alias q='exit'

# ── Prompt ──
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
else
  PROMPT='%F{cyan}%~%f %(?.%F{green}.%F{red})❯%f '
fi

# ── Navigation (zoxide) ──
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
  alias cd='z'
fi

# ── FZF ──
if (( $+commands[fzf] )); then
  source <(fzf --zsh 2>/dev/null)
fi

# ── Carapace completions ──
if (( $+commands[carapace] )); then
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
  source <(carapace _carapace zsh 2>/dev/null)
fi
