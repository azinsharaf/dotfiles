#!/usr/bin/env bash

# Create/attach the global dashboard session with 4 workspaces (tabs)
name="dashboard"
exists=$(tuios ls --json 2>/dev/null | jq -r --arg n "$name" 'any(.[]; .name == $n)')

if [[ "$exists" != "true" ]]; then
    # Create detached session
    tuios new "$name" --detach

    # Get the initial shell window ID
    initial_id=$(tuios list-windows --session "$name" --json | jq -r '.windows[0].window_id')

    # Create one app per workspace
    tuios call new-window '{"session":"'$name'","name":"btop","command":["btop"],"workspace":1}' >/dev/null
    tuios call new-window '{"session":"'$name'","name":"rss","workspace":2}' >/dev/null
    tuios call new-window '{"session":"'$name'","name":"music","workspace":3}' >/dev/null
    tuios call new-window '{"session":"'$name'","name":"shell","workspace":4}' >/dev/null

    # Close the initial empty shell pane
    tuios call close-window '{"session":"'$name'","window":"'$initial_id'"}' >/dev/null
fi

# Always set workspace names (fixes existing sessions too)
tuios set-workspace-name --session "$name" 1 "1: BTOP"
tuios set-workspace-name --session "$name" 2 "2: RSS"
tuios set-workspace-name --session "$name" 3 "3: MUSIC"
tuios set-workspace-name --session "$name" 4 "4: SHELL"

# Focus the first workspace
tuios select-workspace --session "$name" 1

tuios attach "$name"
