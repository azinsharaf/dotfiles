# Include specific configurations based on the remote URL
[includeIf "hasconfig:remote.origin.url=git@bitbucket.org:"]
    path = {{ .chezmoi.homeDir }}/.gitconfig-work

[includeIf "hasconfig:remote.origin.url=git@github.com:"]
    path = {{ .chezmoi.homeDir }}/.gitconfig-personal


[init]
	defaultBranch = main

[pull]
	rebase = true

[core]
	autocrlf = false

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

# Fallback identity (includeIf above overrides it per remote)
[user]
	name = {{ .git_name_personal | quote }}
	email = {{ .git_email_personal | quote }}
