# Work account
Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/.ssh/id_ed25519_bitbucket

# Personal Account (GitHub)
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github

{{ if .macbookProIP }}
# Azin MacBook Pro
Host azin-macbook-pro
    HostName {{ .macbookProIP }}
    User {{ .macbookProUser }}
    IdentityFile ~/.ssh/azin_omarchy_to_macbook
{{ end }}

{{ if .dockerServerIP }}
# Docker server
Host docker-server
    HostName {{ .dockerServerIP }}
    User {{ .dockerServerUser }}
    IdentityFile ~/.ssh/azin_omarchy_to_docker
{{ end }}

{{ if .proxmoxServerIP }}
# Proxmox server
Host proxmox-server
    HostName {{ .proxmoxServerIP }}
    User {{ .proxmoxServerUser }}
    IdentityFile ~/.ssh/azin_omarchy_to_proxmox
{{ end }}

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
