# ── OS-CONDITIONAL IGNORES ──

# Windows-only paths → ignore on Linux / macOS
{{ if ne .chezmoi.os "windows" }}
AppData/**
Documents/**
.config/auto_hotkeys/**
.config/glazewm/**
.config/komorebi/**
.config/nuphy/**
.config/powershell/**
.config/yasb/**
.config/files/**
scoop/**
scripts/windows/**
.config/scripts/windows/**
{{ end }}

# qutebrowser Linux path → hide on Windows (Windows uses AppData path)
{{ if eq .chezmoi.os "windows" }}
.config/qutebrowser/**
{{ end }}

# Linux-only paths → ignore on Windows / macOS
{{ if ne .chezmoi.os "linux" }}
.config/hypr/**
.config/mimeapps.list
.config/autostart
.config/autostart/**
scripts/linux/**
.config/scripts/linux/**
{{ end }}

# macOS-only paths → ignore on Windows / Linux
{{ if ne .chezmoi.os "darwin" }}
scripts/macos/**
{{ end }}

# Ghostty → Linux + macOS only (not Windows)
{{ if eq .chezmoi.os "windows" }}
.config/ghostty/**
{{ end }}

# zsh → Linux + macOS only (not Windows)
{{ if eq .chezmoi.os "windows" }}
.zshenv
.config/zsh
.config/zsh/**
{{ end }}

# bashrc → Linux + macOS only (not Windows)
{{ if eq .chezmoi.os "windows" }}
.bashrc
{{ end }}

# tuios open-project.ps1 → Windows only (Linux uses inline bash)
{{ if ne .chezmoi.os "windows" }}
.config/tuios/open-project.ps1
{{ end }}

