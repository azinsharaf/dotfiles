{{- if stdinIsATTY }}
[data]
    macbookProIP   = {{ promptStringOnce . "macbookProIP"   "MacBook Pro IP address" | quote }}
    macbookProUser = {{ promptStringOnce . "macbookProUser" "MacBook Pro username"   | quote }}
    dockerServerIP   = {{ promptStringOnce . "dockerServerIP"   "Docker server IP address" | quote }}
    dockerServerUser = {{ promptStringOnce . "dockerServerUser" "Docker server username"   | quote }}
    proxmoxServerIP   = {{ promptStringOnce . "proxmoxServerIP"   "Proxmox server IP address" | quote }}
    proxmoxServerUser = {{ promptStringOnce . "proxmoxServerUser" "Proxmox server username"   | quote }}
    terminal          = {{ if eq .chezmoi.os "windows" }}"wezterm"{{ else }}"ghostty"{{ end }}
{{ else }}
[data]
    terminal = {{ if eq .chezmoi.os "windows" }}"wezterm"{{ else }}"ghostty"{{ end }}
{{ end }}

[template]
    options = ["missingkey=zero"]

[add]

[apply]

[diff]

[edit]

[init]

[merge]

[remove]

[re-add]

[verify]

[windows]
    shell = "pwsh"

{{- if eq .chezmoi.os "windows" }}
[cd]
    command = "pwsh"

[shell]
    command = "pwsh"
{{- else }}
